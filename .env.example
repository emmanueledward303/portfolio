# Supabase Configuration (optional - for database persistence)
# Obtain these from your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Password
ADMIN_PASSWORD=edward303

# GitHub Auto-Commit (REQUIRED for online persistence on Vercel)
# Generate a Personal Access Token at: https://github.com/settings/tokens
# Grant 'repo' scope (or 'Contents: Read and write' for fine-grained tokens)
# This allows the admin portal to commit changes directly to your repository
GITHUB_TOKEN=your-github-personal-access-token-here
# Optional overrides (defaults point to emmanueledward303/portfolio on main):
# GITHUB_REPO_OWNER=emmanueledward303
# GITHUB_REPO_NAME=portfolio
# GITHUB_BRANCH=main

# Email / SMTP (for contact form)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password-here
